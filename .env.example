# Copia este archivo a .env y completa los valores reales.
# .env nunca debe commitearse (ver .gitignore).

# --- Supabase (públicas, seguras de exponer en el cliente) ---
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Solo servidor: NUNCA exponer al cliente ni loguear ---
SUPABASE_SERVICE_ROLE_KEY=""
WEBHOOK_DISPATCH_SECRET=""
LOVABLE_API_KEY=""
LOVABLE_SEND_URL=""
ERROR_WEBHOOK_URL=""
# Facturación electrónica (e-CF): cifra la passphrase de los certificados
# digitales que se custodian por tenant. Generar con `openssl rand -base64 32`.
# Ver README.md, sección "Facturación Electrónica (e-CF)".
CERT_ENCRYPTION_KEY=""

# --- Cliente: pública, opcional (captcha en login/signup) ---
VITE_TURNSTILE_SITE_KEY=""
