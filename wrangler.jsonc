{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Corre el handler `scheduled` de src/server.ts todos los días a las 10:00
  // UTC (~6:00 a.m. hora de RD) para enviar recordatorios de cuotas por
  // vencer y avisos de mora.
  "triggers": {
    "crons": ["0 10 * * *"],
  },
}
